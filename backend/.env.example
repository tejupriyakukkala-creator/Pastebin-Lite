# Server port
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/pastebin_lite?retryWrites=true&w=majority

# Public frontend origin for constructing shareable paste URLs (e.g., https://your-app.vercel.app)
BASE_URL=https://your-frontend.example.com

# Allowed CORS origin
FRONTEND_URL=https://your-frontend.example.com

# Enable deterministic testing with x-test-now-ms (set to 1)
TEST_MODE=1

# Environment mode (development | production | test)
NODE_ENV=development

# Content limit in characters (default 1,000,000)
CONTENT_MAX_CHARS=1000000

# JSON body limit
BODY_LIMIT=4mb

# Rate limits per minute
RATE_LIMIT_READ_PER_MIN=300
RATE_LIMIT_CREATE_PER_MIN=120

# Grace period in seconds before real deletion of expired pastes
PURGE_GRACE_SECONDS=86400

# Pino logging level
LOG_LEVEL=info
